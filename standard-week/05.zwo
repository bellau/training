<workout_file>
    <author>Sur-mesure</author>
    <name>5 - Dimanche Récup Active 1h00</name>
    <description>Séance souple de drainage à 55% FTP (~143W), cadence fluide 90-95 rpm. Zéro contrainte.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.55"/>
        <SteadyState Duration="2400" Power="0.55"/>
        <Cooldown Duration="600" PowerLow="0.55" PowerHigh="0.45"/>
    </workout>
</workout_file>