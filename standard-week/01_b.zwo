<workout_file>
    <author>Sur-mesure</author>
    <name>1B - Mardi Seuil Montagne 2x12min</name>
    <description>2 blocs de 12 min à 96% FTP (~250W) à 75-85 rpm pour travailler la tenue en col. Récup 5 min.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.75"/>
        <IntervalsT Repeat="2" OnDuration="60" OnPower="0.95" OffDuration="60" OffPower="0.55"/>
        <SteadyState Duration="180" Power="0.50"/>
        <SteadyState Duration="720" Power="0.96"/>
        <SteadyState Duration="300" Power="0.52"/>
        <SteadyState Duration="720" Power="0.96"/>
        <Cooldown Duration="420" PowerLow="0.55" PowerHigh="0.45"/>
    </workout>
</workout_file>