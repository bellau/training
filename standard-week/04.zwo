<workout_file>
    <author>Sur-mesure</author>
    <name>4 - Samedi Sortie Longue Z2 2h15</name>
    <description>Sortie longue endurance sur HT avec variations douces (60-67% FTP) pour éviter la monotonie. Cardio sous 145 bpm.</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.60"/>
        <IntervalsT Repeat="4" OnDuration="900" OnPower="0.65" OffDuration="600" OffPower="0.60"/>
        <SteadyState Duration="900" Power="0.67"/>
        <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.45"/>
    </workout>
</workout_file>